# Web3Forms — free access key at https://web3forms.com
# Register with your email to receive contact form submissions.
# NEXT_PUBLIC_ is required — Web3Forms free plan only allows browser-side requests.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Canonical site URL (no trailing slash). Used for sitemap, Open Graph, and robots.
NEXT_PUBLIC_SITE_URL=https://abubakar-s-portfolio.vercel.app

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Create a property at https://analytics.google.com → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
